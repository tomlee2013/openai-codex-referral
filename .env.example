# ==============================================================================
# OpenAI Codex Referral & Management System - Environment Configuration
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=0.0.0.0

# Admin Panel Credentials
ADMIN_PASSWORD=admin123456
ADMIN_PATH=admin-secret-dashboard

# Default Account & Registration Settings
DEFAULT_ACCOUNT_PASSWORD=YourSecurePassword123!@

# Cloudflare Worker Email Forwarding Settings
# Used for automatic email verification code (OTP) extraction
WORKER_URL=https://your-worker-email-domain.com
WORKER_ADMIN_AUTH=YourWorkerAdminSecret
WORKER_DOMAIN=your-custom-domain.com

# Default Outbound Proxy (HTTP/SOCKS5, e.g. residential proxy)
DEFAULT_PROXY=

# SMS Risk Verification Fallback Configuration (Optional)
# Supports: 5sim, hero_sms, sms_online
SMS_PROVIDER=5sim
SMS_API_KEY=
SMS_COUNTRY=vietnam

# Hero SMS Configuration (Optional)
HERO_SMS_API_KEY=
HERO_SMS_COUNTRY=10

# SMS Online Configuration (Optional)
SMS_ONLINE_API_KEY=
SMS_ONLINE_COUNTRY=6
SMS_ONLINE_MAX_PRICE=0.06
